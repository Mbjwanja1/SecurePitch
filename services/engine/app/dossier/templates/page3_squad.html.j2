{% extends "base.html.j2" %}
{% block pages %}
<section class="page">
  <header class="run-head">
    <div class="crest">{{ club.short }}</div>
    <div>
      <div class="club">{{ club.name }}</div>
      <div class="sub">SecurePitch Sponsor Dossier · {{ period.label }}</div>
    </div>
    <div class="page-no">Squad Audit <b>03</b> / 04</div>
  </header>

  <div class="title-row" style="margin-bottom: 10pt;">
    <div style="flex: 1;">
      <div class="kicker">Player payment confirmations</div>
      <h1>Squad Audit</h1>
      <p class="lede">Matchday reimbursements are matched to private player attestations, then published here under rotating pseudonyms.</p>
    </div>
    <div class="identity-box">
      <div class="verified" style="font-size: 12pt;">🔒 Identity Protected</div>
      <p style="font-size: 7.5pt; margin: 4pt 0 0;">Names and phone numbers are hidden to protect all players, some of whom are minors. Sponsors see proof of payment—not identity.</p>
    </div>
  </div>

  <div class="audit-header">
    <span><b>18</b> registered squad members · <b>3</b> matchdays</span>
    <span class="gold" style="font-weight: 700; font-size: 12pt;">KES 13,500</span>
  </div>

  <div class="player-grid">
    {% for p in players %}
    <div class="player-card">
      <div class="p-num">{{ "%02d" | format(loop.index) }}</div>
      <div class="p-name">PLAYER {{ "%02d" | format(loop.index) }}</div>
      <div class="p-dates">10 Oct · 17 Oct · 24 Oct</div>
      <div class="p-amount">KES {{ p.amount }}</div>
      <div class="p-status">✔️ confirmed</div>
    </div>
    {% endfor %}
  </div>

  <div class="how-it-works">
    <div class="verified" style="font-size: 9pt; color: var(--seal);">🛡️ How Confirmation Works</div>
    <p style="font-size: 8pt; margin: 4pt 0 0; color: var(--muted);">Each player privately confirms the purpose and amount received. SecurePitch stores a one-way proof, keeps identity out of the public record, and flags any mismatch for the treasurer. These fares match ledger lines 04, 05, 07, 10 (KES 13,500).</p>
  </div>

  <footer class="run-foot">
    <span class="mono">Sealed by SecurePitch · verify at securepitch.vercel.app/v</span>
    <span>SP-KE · 10/26</span>
  </footer>
</section>

<style>
  .identity-box { border-left: 2pt solid var(--seal); padding-left: 12pt; max-width: 200pt; }
  .audit-header { display: flex; justify-content: space-between; border-bottom: 1pt solid var(--line); padding-bottom: 6pt; font-size: 9pt; margin-bottom: 12pt; }
  .player-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12pt 24pt; }
  .player-card { display: grid; grid-template-columns: 20pt 1fr auto; gap: 4pt; align-items: center; border-bottom: 0.5pt solid var(--line); padding-bottom: 6pt; }
  .p-num { color: var(--muted); font-size: 8pt; }
  .p-name { font: 700 10pt "Barlow Condensed"; color: var(--pitch); }
  .p-dates { grid-column: 2; font-size: 7pt; color: var(--muted); }
  .p-amount { grid-column: 3; grid-row: 1; font-weight: 700; font-size: 9pt; }
  .p-status { grid-column: 3; grid-row: 2; font-size: 7pt; color: var(--pitch); text-align: right; }
  .how-it-works { margin-top: 20pt; border-top: 1pt solid var(--line); padding-top: 12pt; }
</style>
{% endblock %}