{#- Page 1 · Summary & authorisation
    Data this page needs (Chris: map these to the sealed payload):
      club.name, club.short           e.g. "Nairobi Lionesses FC", "LNS"
      period.label                    "October 2026"
      dossier.id, dossier.sealed_at   short ID and seal date
      totals.money_in, totals.club_spend, totals.closing_balance, totals.fixtures
      integrity.score                 0-100
      approvers[]                     each: name, role, signed (true/false)
      verify_url, qr_svg              QR as inline SVG markup
      planned_spends[]                each: item, pay_to (till/paybill), amount
      planned_total
      fingerprint                     short hash of the payload
    Money values arrive already formatted, e.g. "KES 7,626". -#}
{% extends "base.html.j2" %}
{% block pages %}
<section class="page">
  <header class="run-head">
    <div class="crest">{{ club.short }}</div>
    <div>
      <div class="club">{{ club.name }}</div>
      <div class="sub">SecurePitch Sponsor Dossier · {{ period.label }}</div>
    </div>
    <div class="page-no">Summary &amp; authorisation <b>01</b> / 04</div>
  </header>

  <div class="title-row">
    <div>
      <div class="kicker">Sponsor assurance statement</div>
      <h1>SecurePitch<br>Sponsor Dossier</h1>
      <p class="lede">A privacy-safe record showing that sponsor funds reached the club and were used for
        football activity — without exposing the coach's personal M-Pesa account.</p>
    </div>
    <dl class="meta">
      <dt>Reporting period</dt><dd class="big">{{ period.label }}</dd>
      <dt>Dossier ID</dt><dd class="mono">{{ dossier.id }}</dd>
      <dt>Prepared</dt><dd>{{ dossier.sealed_at }} · Nairobi</dd>
    </dl>
  </div>

  <h2><span class="no">01</span> Club account summary</h2>
  <div class="stats">
    <div><span>Sponsor money in</span><b>{{ totals.money_in }}</b></div>
    <div><span>Club spending</span><b>{{ totals.club_spend }}</b></div>
    <div><span>Closing balance</span><b class="gold">{{ totals.closing_balance }}</b></div>
    <div><span>Transactions</span><b>{{ totals.fixtures }}</b></div>
  </div>

  <h2><span class="no">02</span> Independent verification</h2>
  <div class="verify">
    <div class="status">
      <div class="verified">✓ Verified</div>
      <div class="sub" style="margin-bottom: 8pt;">Records sealed · {{ dossier.sealed_at }}</div>
      <div class="score"><b>{{ integrity.score }}</b>/100 <span>integrity score</span></div>
      <div class="approvers">
        {% for a in approvers %}
        <div class="approver">
          <div class="sig">{{ a.name }}</div>
          <div class="role">{{ a.role }} · {{ "Approved" if a.signed else "Pending" }}</div>
        </div>
        {% endfor %}
      </div>
    </div>
    <div class="qr">
      <div class="qr-label">Public verification</div>
      <div style="font-size: 7.5pt; color: var(--muted); margin-bottom: 4pt;">Scan to verify this dossier</div>
      {{ qr_svg | safe }}
      <div class="qr-url">{{ verify_url }}</div>
      <div style="font-size: 7pt; color: var(--muted); margin-top: 4pt;">No personal M-Pesa activity is displayed.</div>
    </div>
  </div>

  <h2><span class="no">03</span> Planned spends · pay suppliers directly</h2>
  <table class="spends">
    <thead><tr><th>Item / purpose</th><th>Supplier till or paybill</th><th class="num">Amount</th></tr></thead>
    <tbody>
      {% for s in planned_spends %}
      <tr><td>{{ s.item }}</td><td class="mono">{{ s.pay_to }}</td><td class="num">{{ s.amount }}</td></tr>
      {% else %}
      <tr><td colspan="3" class="empty">No planned spends listed for this period.</td></tr>
      {% endfor %}
    </tbody>
    <tfoot>
      <tr>
        <td colspan="2" style="text-align: right;">Planned total</td>
        <td class="num">
          {{ planned_total }}
          <span class="small-note">KES 13,500 confirmed player fares</span>
        </td>
      </tr>
    </tfoot>
  </table>

  <div class="summary-bar">
    <div>
      <span>Covered by October balance</span>
      <b>{{ totals.closing_balance }}</b>
    </div>
    <div>
      <span>Requested from November tranche</span>
      <b class="gold">KES 23,200</b>
    </div>
    <div>
      <span>Paid to</span>
      <b>Supplier tills only</b>
    </div>
  </div>

  <footer class="run-foot">
    <span class="mono">Dossier fingerprint · {{ fingerprint }}</span>
    <span>Sealed by SecurePitch · verify at securepitch.vercel.app/v</span>
  </footer>
</section>
{% endblock %}