# Copy to services/engine/.env and fill in. .env is git-ignored; never commit it.

# Shared secret the web app sends in X-Internal-Key. Generate with:
#   py -c "import secrets; print(secrets.token_urlsafe(32))"
ENGINE_INTERNAL_KEY=

# Supabase (Project Settings -> API / Database)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# AWS KMS: credentials of the securepitch-engine IAM user (sign-only)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=af-south-1
KMS_KEY_ID=alias/securepitch-seal
KMS_KID=sp-2026-01
SIGNER=kms                # kms | local
LOCAL_SIGNING_KEY_PEM=    # only when SIGNER=local

# HMAC pepper for roster phone keys: 32 random bytes, base64. Generate with:
#   py -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
ROSTER_PEPPER=

PUBLIC_VERIFY_BASE=https://securepitch.vercel.app/v
