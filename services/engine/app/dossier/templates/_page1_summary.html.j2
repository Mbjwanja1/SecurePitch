<section class="page">
  <div class="run-head">
    <div class="crest"><div class="crest-box"><span class="crest-text">{{ club.short }}</span></div></div>
    <div class="club-name">
      <h2>{{ club.name }}</h2>
      <p>SECUREPITCH SPONSOR DOSSIER · {{ period.label }}</p>
    </div>
  </div>

  <div class="title-row">
    <p class="kicker">SPONSOR ASSURANCE STATEMENT</p>
    <h1>SECUREPITCH SPONSOR DOSSIER</h1>
    <p class="subtitle">A privacy-safe record showing that sponsor funds reached the club and were used for football activity—without exposing the coach's personal M-Pesa account.</p>
  </div>

  <div class="meta">
    <div><p class="label">REPORTING PERIOD</p><h3>{{ period.label }}</h3></div>
    <div><p class="label">DOSSIER ID</p><p class="mono">{{ dossier.id }}</p></div>
    <div><p class="label">PREPARED</p><p class="mono">{{ sealed_at }} - Nairobi</p></div>
  </div>

  <div class="section-title">01 CLUB ACCOUNT SUMMARY</div>
  <div class="summary-bar">
    <div class="stat"><p class="label">CLUB SPENDING</p><h3 class="mono">{{ totals.club_spending }}</h3></div>
    <div class="stat"><p class="label">TRANSACTIONS</p><h3 class="mono">{{ rows_disclosed }}</h3></div>
    <div class="stat net"><p class="label">NET CLUB FUNDS</p><h3 class="mono">{{ totals.net_funds }}</h3></div>
  </div>

  <div class="section-title">02 INDEPENDENT VERIFICATION</div>
  <div class="verify">
    <div class="verify-left">
      <h2>SEALED</h2>
      <p class="small-note">RECORDS SEALED · {{ sealed_at_short }}</p>
      <div class="signatures">
        <div class="sig"><p class="small-note">Manager · approved</p></div>
        <div class="sig"><p class="small-note">Treasurer · approved</p></div>
      </div>
    </div>
    <div class="verify-right"><h2 class="score">{{ integrity.score }}/100</h2><p class="small-note">INTEGRITY SCORE</p><p class="small-note">{{ integrity.source }}</p></div>
  </div>

  <div class="qr-block">
    <div class="qr-code">{{ qr_svg | safe }}</div>
    <div class="qr-text">
      <p class="label">PUBLIC VERIFICATION</p>
      <p>Scan to verify this dossier at <span class="mono">{{ verify_base }}/{{ dossier.id }}</span></p>
      <p class="small-note">No personal M-Pesa activity is displayed.</p>
    </div>
  </div>

  <div class="section-title">03 PLANNED SPENDS - PAY SUPPLIERS DIRECTLY</div>
  <table class="spends-table">
    <thead><tr><th>ITEM / PURPOSE</th><th>SUPPLIER TILL OR PAYBILL</th><th class="right">AMOUNT</th></tr></thead>
    <tbody>
      {% for spend in planned_spends %}
      <tr><td>{{ spend.purpose }}</td><td class="mono">{{ spend.till }}</td><td class="right mono">{{ spend.amount }}</td></tr>
      {% else %}
      <tr><td colspan="3" class="small-note">No planned spends listed.</td></tr>
      {% endfor %}
    </tbody>
  </table>

  <div class="run-foot"><p>Sealed by SecurePitch · verify at {{ verify_base }}/{{ dossier.id }}</p><p class="mono">{{ kid }}</p></div>
</section>
