<section class="page">
  <div class="run-head">
    <div class="crest"><div class="crest-box"><span class="crest-text">LION<br/>ESSES</span></div></div>
    <div class="club-name"><h2>{{ club.name }}</h2><p>SECUREPITCH SPONSOR DOSSIER · {{ period.label }}</p></div>
    <div class="page-num">03 / 04</div>
  </div>

  <div class="title-row">
    <p class="kicker">PLAYER PAYMENT CONFIRMATIONS</p>
    <h1>SQUAD AUDIT</h1>
    <p class="subtitle">Matchday reimbursements are matched to private player attestations, then published here under rotating pseudonyms. Sponsors see proof of payment—not identity.</p>
  </div>

  <div class="meta">
    <div><p class="label">AUDIT SCOPE</p><p class="mono">{{ squad.registered }} registered squad members · {{ squad.matchdays }} matchdays</p></div>
    <div><p class="label">CONFIRMED REIMBURSEMENTS</p><h3 class="mono">KES {{ squad.total }}</h3></div>
  </div>

  <div class="squad-grid">
    {% for p in players %}
    <div class="player-card">
      <div>
        <p class="player-name">{{ p.pseudonym }}</p>
        <p class="player-details">Matchday bus fare · {{ p.dates | join(" · ") }}</p>
      </div>
      <div class="right">
        <p class="mono" style="font-size: 14px; font-weight: bold; color: var(--pitch);">KES {{ p.amount }}</p>
        <p class="small-note"><span class="check">✓</span> {{ p.status }}</p>
      </div>
    </div>
    {% endfor %}
  </div>

  <div class="run-foot"><p>Sealed by SecurePitch · verify at {{ verify_base }}/{{ dossier.id }}</p><p class="mono">{{ kid }}</p></div>
</section>