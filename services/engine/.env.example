# Copy to services/engine/.env and fill in. .env is git-ignored; never commit it.

# prod hides /docs. Set to dev only while working locally, never with the tunnel running.
ENGINE_ENV=prod

# Shared secret the web app sends in X-Internal-Key. Generate with (on Windows, use `py`):
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ENGINE_INTERNAL_KEY=

# Supabase
# Bare project URL only (Project Settings -> Data API). No /rest/v1 on the end.
SUPABASE_URL=https://<project-ref>.supabase.co
# Project Settings -> API Keys -> Secret keys (sb_secret_...). Bypasses RLS: engine only.
SUPABASE_SERVICE_ROLE_KEY=
# Migrations only; the engine itself uses HTTPS (docs/adr/0002). Connect -> Connection string
# -> Session pooler (IPv4). Not "Direct connection" (IPv6 only).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-eu-central-1.pooler.supabase.com:5432/postgres

# Signing: kms for real dossiers, local while AWS isn't ready (docs/CRYPTO_SPEC.md section 5)
SIGNER=kms
# AWS KMS: credentials of the securepitch-engine IAM user (sign-only)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=af-south-1
KMS_KEY_ID=alias/securepitch-seal
KMS_KID=sp-2026-01
# Local signer (SIGNER=local). Generate a key with:
#   uv run --directory services/engine python -m app.crypto.signer --generate
LOCAL_SIGNING_KEY=
LOCAL_KID=local-dev

# HMAC pepper for roster phone keys: 32 random bytes, base64. Generate with (on Windows, `py`):
#   python3 -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
ROSTER_PEPPER=

PUBLIC_VERIFY_BASE=https://securepitch.vercel.app/v

# Passkeys (docs/adr/0003-passkey-approvals.md). The RP ID is the web app's domain, with no
# scheme or port; origins are the exact page origins, comma-separated. Passkeys registered on
# one domain don't work on another.
#   local:    WEBAUTHN_RP_ID=localhost  WEBAUTHN_ORIGINS=http://localhost:3000
#   deployed: WEBAUTHN_RP_ID=securepitch.vercel.app  WEBAUTHN_ORIGINS=https://securepitch.vercel.app
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGINS=http://localhost:3000
