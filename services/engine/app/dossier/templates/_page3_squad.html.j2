<section class="page">
  <div class="run-head">
    <div class="crest"><div class="crest-box"><span class="crest-text">{{ club.short }}</span></div></div>
    <div class="club-name"><h2>{{ club.name }}</h2><p>SECUREPITCH SPONSOR DOSSIER · {{ period.label }}</p></div>
  </div>

  <div class="title-row">
    <p class="kicker">PLAYER PAYMENT CONFIRMATIONS</p>
    <h1>SQUAD AUDIT</h1>
    <p class="subtitle">Payments to players are matched to the club's registered squad, then published here under pseudonyms. Sponsors see proof of payment—not identity.</p>
  </div>

  <div class="meta">
    <div><p class="label">AUDIT SCOPE</p><p class="mono">{{ squad.players }} players paid · {{ squad.matchdays }} matchdays</p></div>
    <div><p class="label">PAID TO PLAYERS</p><h3 class="mono">{{ squad.total }}</h3></div>
  </div>

  <div class="squad-grid">
    {% for p in players %}
    <div class="player-card">
      <div>
        <p class="player-name">{{ p.pseudonym }}</p>
        <p class="player-details">{{ p.what }} · {{ p.dates | join(" · ") }}</p>
      </div>
      <div class="right">
        <p class="mono" style="font-size: 14px; font-weight: bold; color: var(--pitch);">{{ p.amount }}</p>
        <p class="small-note">
          {% if p.confirmed %}
            <span class="check">✓</span> Confirmed
          {% else %}
            Awaiting confirmation
          {% endif %}
        </p>
      </div>
    </div>
    {% else %}
    <p class="small-note grid-note">No payments to registered players in this period.</p>
    {% endfor %}
  </div>

  <div class="run-foot"><p>Sealed by SecurePitch · verify at {{ verify_base }}/{{ dossier.id }}</p><p class="mono">{{ kid }}</p></div>
</section>
