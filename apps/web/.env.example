# Copy to apps/web/.env.local and fill in. .env.local is git-ignored; never commit it.

# Supabase: Project Settings -> Data API (URL, nothing after .co)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Project Settings -> API Keys -> Publishable key (sb_publishable_...). Safe in the browser;
# row-level security decides what it can read. Never put the secret key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Engine (server-side only; no NEXT_PUBLIC_ prefix, so it never reaches the browser)
ENGINE_URL=http://127.0.0.1:8000
ENGINE_INTERNAL_KEY=
